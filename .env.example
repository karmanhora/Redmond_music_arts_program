# Frontend environment — copy to `.env.local` and fill in.
# `.env.local` is gitignored; these are frontend variables only.

# Supabase project (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Supabase Auth is the sign-in system, and it needs no extra frontend variable:
# the same URL + anon key above sign in, restore the session and authenticate
# every query. The signed-in user's id (`auth.uid()`) is what `profiles.auth_user_id`
# holds, so nothing else has to be passed to the app.
#
# The two settings that do matter live in the Supabase dashboard, not here
# (Dashboard → Authentication → URL Configuration):
#   Site URL      — this app's origin
#   Redirect URLs — the same origin plus `<origin>/reset-password`, where the
#                   password-recovery link lands. Both are needed per origin
#                   (production and http://localhost:5173).
#
# No key belongs in this file except the anon (publishable) one. The
# service-role key must never be given a VITE_ prefix or reach the browser.
