# Frontend environment — copy to `.env.local` and fill in.
# `.env.local` is gitignored; these are frontend variables only.

# Supabase project (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Clerk (Dashboard → API keys → Publishable key). Public by design.
# This is what turns a Clerk session into the Supabase `authenticated` role
# (Clerk is configured as a Supabase Third-Party Auth provider).
# Vite deployments can use VITE_CLERK_PUBLISHABLE_KEY; NEXT_PUBLIC_ is also
# supported for existing hosting environments using that public variable name.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Production only: proxy Clerk requests through the application's domain.
# Leave unset in local development and deployments without a Clerk proxy.
# VITE_CLERK_PROXY_URL=https://your-domain.example/_clerk/
